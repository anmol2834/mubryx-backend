generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  TECHNICIAN
  ADMIN
  SUPER_ADMIN
}

enum OnboardingStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  email     String?  @unique
  name      String?
  role      UserRole @default(CUSTOMER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions          Session[]
  refreshTokens     RefreshToken[]
  customerProfile   CustomerProfile?
  technicianProfile TechnicianProfile?
  carts             Cart[]
  addresses         CustomerAddress[]
  bookings          Booking[]

  @@index([phone])
  @@index([role])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  deviceInfo   String?
  ipAddress    String?
  userAgent    String?
  isActive     Boolean  @default(true)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken RefreshToken?

  @@index([userId])
  @@index([isActive])
  @@map("sessions")
}

model RefreshToken {
  id        String   @id @default(cuid())
  sessionId String   @unique
  userId    String
  tokenHash String   @unique
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime

  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model CustomerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DocumentType {
  AADHAAR
  PAN
  DRIVING_LICENSE
  PASSPORT
  VOTER_ID
  OTHER
}

model TechnicianProfile {
  id               String                 @id @default(cuid())
  userId           String                 @unique
  fullName         String?
  dateOfBirth      String?
  gender           Gender?
  currentCity      String?
  pinCode          String?
  bio              String?
  experienceYears  Int?
  onboardingStatus OnboardingStatus       @default(DRAFT)
  submittedAt      DateTime?
  profilePhoto     String?
  documents        TechnicianDocument[]
  experiences      TechnicianExperience[]
  skills           Category[]             @relation("TechnicianSkills")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([onboardingStatus])
  @@map("technician_profiles")
}

model TechnicianDocument {
  id           String            @id @default(cuid())
  technicianId String
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  type         DocumentType
  objectKey    String
  mimeType     String
  fileSize     Int
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([technicianId])
  @@map("technician_documents")
}

model TechnicianExperience {
  id               String            @id @default(cuid())
  technicianId     String
  technician       TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  totalExperience  String
  companyName      String
  role             String
  startDate        String
  endDate          String
  city             String?
  responsibilities String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([technicianId])
  @@map("technician_experiences")
}

enum CategoryPlacement {
  QUICK_SERVICE
  APPLIANCE
  NONE
}

model Category {
  id                String              @id @default(cuid())
  name              String
  slug              String              @unique
  icon              String?
  image             String?
  description       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  bgColor           String?
  displayOrder      Int                 @default(0)
  iconBg            String?
  iconColor         String?
  placement         CategoryPlacement   @default(NONE)
  Service           Service[]
  technicianProfiles TechnicianProfile[] @relation("TechnicianSkills")
}

model Service {
  id            String        @id @default(cuid())
  categoryId    String
  title         String
  description   String
  price         Float
  discountPrice Float?
  rating        Float         @default(4.8)
  reviewCount   Int           @default(0)
  duration      String        @default("45 mins")
  image         String?
  features      String[]      @default([])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  iconBg        String?
  iconColor     String?
  isActive      Boolean       @default(true)
  isPopular     Boolean       @default(false)
  svgType       String?
  tag           String?
  tagBg         String?
  tagColor      String?
  Category      Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  bookingItems  BookingItem[]
}

enum CartStatus {
  ACTIVE
  CHECKOUT_STARTED
  CONVERTED
  ABANDONED
  EXPIRED
}

model Cart {
  id             String      @id @default(cuid())
  customerId     String
  status         CartStatus  @default(ACTIVE)
  currency       String      @default("INR")
  version        Int         @default(1)
  lastActivityAt DateTime    @default(now())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  customer       User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items          CartItem[]

  @@index([customerId])
  @@index([status])
  @@index([customerId, status])
  @@map("carts")
}

model CartItem {
  id           String   @id @default(cuid())
  cartId       String
  serviceId    String
  quantity     Int      @default(1)
  unitPrice    Float
  lineTotal    Float
  specialNotes String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cart         Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([cartId, serviceId])
  @@index([cartId])
  @@index([serviceId])
  @@map("cart_items")
}

model CustomerAddress {
  id              String    @id @default(cuid())
  customerId      String
  label           String    @default("Home")
  completeAddress String
  landmark        String?
  city            String?   @default("Ahmedabad")
  state           String?   @default("Gujarat")
  postalCode      String?
  latitude        Float?
  longitude       Float?
  isDefault       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer        User      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookings        Booking[]

  @@unique([customerId, label])
  @@index([customerId])
  @@index([customerId, isDefault])
  @@map("customer_addresses")
}

// ─── Booking Enums ────────────────────────────────────────────────────────────

enum BookingType {
  ASAP
  SCHEDULED
}

enum BookingStatus {
  PENDING_MATCHING
  TECHNICIAN_SEARCHING
  TECHNICIAN_ASSIGNED
  TECHNICIAN_ACCEPTED
  TECHNICIAN_ON_THE_WAY
  TECHNICIAN_ARRIVED
  SERVICE_STARTED
  SERVICE_COMPLETED
  PAYMENT_PENDING
  COMPLETED
  CANCELLED
  FAILED
}

enum PaymentMethod {
  CASH_ON_SERVICE
  UPI
  CARD
  WALLET
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

// ─── Booking Models ───────────────────────────────────────────────────────────

model Booking {
  id             String        @id @default(cuid())
  bookingNumber  String        @unique
  customerId     String
  addressId      String?
  idempotencyKey String        @unique

  // Immutable address snapshot taken at booking time
  snapshotLabel     String
  snapshotAddress   String
  snapshotLandmark  String?
  snapshotCity      String?
  snapshotState     String?
  snapshotPostalCode String?
  serviceLatitude   Float?
  serviceLongitude  Float?

  // Customer's current GPS at time of booking (separate from service location)
  customerCurrentLat Float?
  customerCurrentLng Float?

  // Schedule
  bookingType  BookingType   @default(ASAP)
  scheduledAt  DateTime?

  // Lifecycle
  status              BookingStatus @default(PENDING_MATCHING)
  technicianId        String?
  assignedAt          DateTime?
  acceptedAt          DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?

  // Payment
  paymentMethod  PaymentMethod @default(CASH_ON_SERVICE)
  paymentStatus  PaymentStatus @default(PENDING)

  // Pricing (server-authoritative, immutable after creation)
  subtotal    Float
  discount    Float  @default(0)
  tax         Float
  platformFee Float
  totalAmount Float
  couponCode  String?

  // Notes
  customerNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  customer      User             @relation(fields: [customerId], references: [id])
  address       CustomerAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items         BookingItem[]
  statusHistory BookingStatusHistory[]

  @@index([customerId])
  @@index([status])
  @@index([customerId, status])
  @@index([createdAt])
  @@index([scheduledAt])
  @@index([technicianId])
  @@map("bookings")
}

model BookingItem {
  id        String @id @default(cuid())
  bookingId String
  serviceId String

  // Immutable price/service snapshots at booking time
  serviceTitleSnapshot  String
  categoryNameSnapshot  String?
  durationSnapshot      String?
  quantity              Int    @default(1)
  unitPrice             Float
  discount              Float  @default(0)
  lineTotal             Float

  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@index([bookingId])
  @@index([serviceId])
  @@map("booking_items")
}

model BookingStatusHistory {
  id            String        @id @default(cuid())
  bookingId     String
  fromStatus    BookingStatus?
  toStatus      BookingStatus
  changedBy     String?
  changedByType String?       // 'CUSTOMER' | 'TECHNICIAN' | 'SYSTEM' | 'ADMIN'
  reason        String?
  metadata      Json?
  createdAt     DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([createdAt])
  @@map("booking_status_history")
}

