generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  TECHNICIAN
  ADMIN
  SUPER_ADMIN
}

enum OnboardingStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  email     String?  @unique
  name      String?
  role      UserRole @default(CUSTOMER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions       Session[]
  refreshTokens  RefreshToken[]
  customerProfile CustomerProfile?
  technicianProfile TechnicianProfile?
  carts          Cart[]

  @@index([phone])
  @@index([role])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  deviceInfo   String?
  ipAddress    String?
  userAgent    String?
  isActive     Boolean  @default(true)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken RefreshToken?

  @@index([userId])
  @@index([isActive])
  @@map("sessions")
}

model RefreshToken {
  id        String   @id @default(cuid())
  sessionId String   @unique
  userId    String
  tokenHash String   @unique
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime

  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model CustomerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DocumentType {
  AADHAAR
  PAN
  DRIVING_LICENSE
  PASSPORT
  VOTER_ID
  OTHER
}

model TechnicianProfile {
  id               String                 @id @default(cuid())
  userId           String                 @unique
  fullName         String?
  dateOfBirth      String?
  gender           Gender?
  currentCity      String?
  pinCode          String?
  bio              String?
  experienceYears  Int?
  onboardingStatus OnboardingStatus       @default(DRAFT)
  submittedAt      DateTime?
  profilePhoto     String?
  documents        TechnicianDocument[]
  experiences      TechnicianExperience[]
  skills           Category[]             @relation("TechnicianSkills")
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([onboardingStatus])
  @@map("technician_profiles")
}

model TechnicianDocument {
  id           String            @id @default(cuid())
  technicianId String
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  type         DocumentType
  objectKey    String
  mimeType     String
  fileSize     Int
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([technicianId])
  @@map("technician_documents")
}

model TechnicianExperience {
  id               String            @id @default(cuid())
  technicianId     String
  technician       TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  totalExperience  String
  companyName      String
  role             String
  startDate        String
  endDate          String
  city             String?
  responsibilities String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([technicianId])
  @@map("technician_experiences")
}

enum CategoryPlacement {
  QUICK_SERVICE
  APPLIANCE
  NONE
}

model Category {
  id                String              @id @default(cuid())
  name              String
  slug              String              @unique
  icon              String?
  image             String?
  description       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  bgColor           String?
  displayOrder      Int                 @default(0)
  iconBg            String?
  iconColor         String?
  placement         CategoryPlacement   @default(NONE)
  Service           Service[]
  technicianProfiles TechnicianProfile[] @relation("TechnicianSkills")
}

model Service {
  id            String        @id @default(cuid())
  categoryId    String
  title         String
  description   String
  price         Float
  discountPrice Float?
  rating        Float         @default(4.8)
  reviewCount   Int           @default(0)
  duration      String        @default("45 mins")
  image         String?
  features      String[]      @default([])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  iconBg        String?
  iconColor     String?
  isActive      Boolean       @default(true)
  isPopular     Boolean       @default(false)
  svgType       String?
  tag           String?
  tagBg         String?
  tagColor      String?
  Category      Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
}

enum CartStatus {
  ACTIVE
  CHECKOUT_STARTED
  CONVERTED
  ABANDONED
  EXPIRED
}

model Cart {
  id             String      @id @default(cuid())
  customerId     String
  status         CartStatus  @default(ACTIVE)
  currency       String      @default("INR")
  version        Int         @default(1)
  lastActivityAt DateTime    @default(now())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  customer       User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items          CartItem[]

  @@index([customerId])
  @@index([status])
  @@index([customerId, status])
  @@map("carts")
}

model CartItem {
  id           String   @id @default(cuid())
  cartId       String
  serviceId    String
  quantity     Int      @default(1)
  unitPrice    Float
  lineTotal    Float
  specialNotes String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cart         Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([cartId, serviceId])
  @@index([cartId])
  @@index([serviceId])
  @@map("cart_items")
}
