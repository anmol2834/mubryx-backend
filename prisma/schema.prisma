generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CUSTOMER
  TECHNICIAN
  ADMIN
  SUPER_ADMIN
}

enum OnboardingStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum DispatchStatus {
  OFFERED
  VIEWED
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
  SUPERSEDED
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  email     String?  @unique
  name      String?
  role      UserRole @default(CUSTOMER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions          Session[]
  refreshTokens     RefreshToken[]
  customerProfile   CustomerProfile?
  technicianProfile TechnicianProfile?
  carts             Cart[]
  addresses         CustomerAddress[]
  bookings          Booking[]
  notifications     Notification[]
  pushTokens        DevicePushToken[]
  reviews           Review[]

  @@index([phone])
  @@index([role])
  @@map("users")
}

model Session {
  id           String   @id @default(cuid())
  userId       String
  deviceInfo   String?
  ipAddress    String?
  userAgent    String?
  isActive     Boolean  @default(true)
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshToken RefreshToken?

  @@index([userId])
  @@index([isActive])
  @@map("sessions")
}

model RefreshToken {
  id        String   @id @default(cuid())
  sessionId String   @unique
  userId    String
  tokenHash String   @unique
  isRevoked Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime

  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([tokenHash])
  @@map("refresh_tokens")
}

model CustomerProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum DocumentType {
  AADHAAR
  PAN
  DRIVING_LICENSE
  PASSPORT
  VOTER_ID
  OTHER
}

model TechnicianProfile {
  id               String                 @id @default(cuid())
  userId           String                 @unique
  fullName         String?
  contact          String?
  dateOfBirth      String?
  gender           Gender?
  currentCity      String?
  currentState     String?
  latitude         Float?
  longitude        Float?
  pinCode          String?
  bio              String?
  experienceYears  Int?
  onboardingStatus OnboardingStatus       @default(DRAFT)
  submittedAt      DateTime?
  profilePhoto     String?
  documents        TechnicianDocument[]
  experiences      TechnicianExperience[]
  skills           Category[]             @relation("TechnicianSkills")
  isOnline         Boolean                @default(false)
  lastLocationUpdatedAt DateTime?
  
  rating           Float?                 @default(0.0)
  totalRatings     Int                    @default(0)

  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  dispatches       BookingDispatch[]
  bookings         Booking[]
  bookingItems     BookingItem[]
  reviews          Review[]

  user             User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  bankDetails      TechnicianBankDetails?
  wallet           TechnicianWallet?

  @@index([onboardingStatus])
  @@map("technician_profiles")
}

model TechnicianDocument {
  id           String            @id @default(cuid())
  technicianId String
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  type         DocumentType
  objectKey    String
  mimeType     String
  fileSize     Int
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([technicianId])
  @@map("technician_documents")
}

model TechnicianExperience {
  id               String            @id @default(cuid())
  technicianId     String
  technician       TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  totalExperience  String
  companyName      String
  role             String
  startDate        String
  endDate          String
  city             String?
  responsibilities String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([technicianId])
  @@map("technician_experiences")
}

model TechnicianBankDetails {
  id             String            @id @default(cuid())
  technicianId   String            @unique
  technician     TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  bankName       String
  accountNumber  String
  ifsc           String
  accountHolder  String
  isVerified     Boolean           @default(false)
  upiId          String?
  upiVerified    Boolean           @default(false)
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@map("technician_bank_details")
}

enum CategoryPlacement {
  QUICK_SERVICE
  APPLIANCE
  NONE
}

model Category {
  id                String              @id @default(cuid())
  name              String
  slug              String              @unique
  icon              String?
  image             String?
  description       String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  bgColor           String?
  displayOrder      Int                 @default(0)
  iconBg            String?
  iconColor         String?
  placement         CategoryPlacement   @default(NONE)
  Service           Service[]
  technicianProfiles TechnicianProfile[] @relation("TechnicianSkills")
}

model Service {
  id            String        @id @default(cuid())
  categoryId    String
  title         String
  description   String
  price         Float
  discountPrice Float?
  rating        Float         @default(4.8)
  reviewCount   Int           @default(0)
  duration      String        @default("45 mins")
  image         String?
  features      String[]      @default([])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime
  iconBg        String?
  iconColor     String?
  isActive      Boolean       @default(true)
  isPopular     Boolean       @default(false)
  svgType       String?
  tag           String?
  tagBg         String?
  tagColor      String?
  Category      Category      @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  cartItems     CartItem[]
  bookingItems  BookingItem[]
  reviews       Review[]
}

enum CartStatus {
  ACTIVE
  CHECKOUT_STARTED
  CONVERTED
  ABANDONED
  EXPIRED
}

model Cart {
  id             String      @id @default(cuid())
  customerId     String
  status         CartStatus  @default(ACTIVE)
  currency       String      @default("INR")
  version        Int         @default(1)
  lastActivityAt DateTime    @default(now())
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  customer       User        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  items          CartItem[]

  @@index([customerId])
  @@index([status])
  @@index([customerId, status])
  @@map("carts")
}

model CartItem {
  id           String   @id @default(cuid())
  cartId       String
  serviceId    String
  quantity     Int      @default(1)
  unitPrice    Float
  lineTotal    Float
  specialNotes String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cart         Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  service      Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([cartId, serviceId])
  @@index([cartId])
  @@index([serviceId])
  @@map("cart_items")
}

model CustomerAddress {
  id              String    @id @default(cuid())
  customerId      String
  label           String    @default("Home")
  completeAddress String
  landmark        String?
  city            String?   @default("Ahmedabad")
  state           String?   @default("Gujarat")
  postalCode      String?
  latitude        Float?
  longitude       Float?
  isDefault       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  customer        User      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  bookings        Booking[]

  @@unique([customerId, label])
  @@index([customerId])
  @@index([customerId, isDefault])
  @@map("customer_addresses")
}

// ─── Booking Enums ────────────────────────────────────────────────────────────

enum BookingType {
  ASAP
  SCHEDULED
}

enum BookingStatus {
  PENDING_MATCHING
  TECHNICIAN_SEARCHING
  PARTIALLY_ASSIGNED
  TECHNICIAN_ASSIGNED
  TECHNICIAN_ACCEPTED
  TECHNICIAN_ON_THE_WAY
  TECHNICIAN_ARRIVED
  SERVICE_STARTED
  SERVICE_COMPLETED
  PAYMENT_PENDING
  COMPLETED
  CANCELLED
  FAILED
}

enum BookingItemStatus {
  PENDING_MATCHING
  TECHNICIAN_SEARCHING
  TECHNICIAN_ASSIGNED
  TECHNICIAN_ACCEPTED
  TECHNICIAN_ON_THE_WAY
  TECHNICIAN_ARRIVED
  SERVICE_STARTED
  SERVICE_COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH_ON_SERVICE
  UPI
  CARD
  WALLET
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

// ─── Booking Models ───────────────────────────────────────────────────────────

model Booking {
  id             String        @id @default(cuid())
  bookingNumber  String        @unique
  customerId     String
  addressId      String?
  idempotencyKey String        @unique

  // Immutable address snapshot taken at booking time
  snapshotLabel     String
  snapshotAddress   String
  snapshotLandmark  String?
  snapshotCity      String?
  snapshotState     String?
  snapshotPostalCode String?
  serviceLatitude   Float?
  serviceLongitude  Float?

  // Customer's current GPS at time of booking (separate from service location)
  customerCurrentLat Float?
  customerCurrentLng Float?

  // Schedule
  bookingType  BookingType   @default(ASAP)
  scheduledAt  DateTime?

  // Lifecycle
  status              BookingStatus @default(PENDING_MATCHING)
  technicianId        String?
  technician          TechnicianProfile? @relation(fields: [technicianId], references: [id])
  assignedAt          DateTime?
  acceptedAt          DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?

  // Payment
  paymentMethod  PaymentMethod @default(CASH_ON_SERVICE)
  paymentStatus  PaymentStatus @default(PENDING)

  // Pricing (server-authoritative, immutable after creation)
  subtotal    Float
  discount    Float  @default(0)
  tax         Float
  totalAmount Float
  couponCode  String?
  otp         String?
  happyCode   String?

  // Invoice
  invoiceNumber      String?   @unique
  invoiceUrl         String?
  invoiceGeneratedAt DateTime?

  // Notes
  customerNotes String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  customer      User             @relation(fields: [customerId], references: [id])
  address       CustomerAddress? @relation(fields: [addressId], references: [id], onDelete: SetNull)
  items         BookingItem[]
  statusHistory BookingStatusHistory[]
  dispatches    BookingDispatch[]
  spareParts    BookingSparePart[]
  review        Review?

  @@index([customerId])
  @@index([status])
  @@index([customerId, status])
  @@index([createdAt])
  @@index([scheduledAt])
  @@index([technicianId])
  @@map("bookings")
}

model BookingItem {
  id        String @id @default(cuid())
  bookingId String
  serviceId String

  // Immutable price/service snapshots at booking time
  serviceTitleSnapshot  String
  categoryNameSnapshot  String?
  durationSnapshot      String?
  quantity              Int    @default(1)
  unitPrice             Float
  discount              Float  @default(0)
  lineTotal             Float

  status              BookingItemStatus @default(PENDING_MATCHING)
  technicianId        String?
  technician          TechnicianProfile? @relation(fields: [technicianId], references: [id])
  assignedAt          DateTime?
  acceptedAt          DateTime?
  startedAt           DateTime?
  completedAt         DateTime?
  cancelledAt         DateTime?
  cancellationReason  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])
  dispatches BookingDispatch[]

  @@index([bookingId])
  @@index([serviceId])
  @@index([status])
  @@index([technicianId])
  @@map("booking_items")
}

model BookingStatusHistory {
  id            String        @id @default(cuid())
  bookingId     String
  fromStatus    BookingStatus?
  toStatus      BookingStatus
  changedBy     String?
  changedByType String?       // 'CUSTOMER' | 'TECHNICIAN' | 'SYSTEM' | 'ADMIN'
  reason        String?
  metadata      Json?
  createdAt     DateTime      @default(now())

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  @@index([bookingId])
  @@index([createdAt])
  @@map("booking_status_history")
}

model BookingDispatch {
  id           String   @id @default(cuid())
  bookingId    String
  bookingItemId String
  technicianId String
  distanceKm   Float
  status       DispatchStatus @default(OFFERED)
  expiresAt    DateTime
  respondedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  booking      Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  bookingItem  BookingItem       @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)

  @@unique([bookingItemId, technicianId])
  @@index([technicianId])
  @@index([bookingId])
  @@index([bookingItemId])
  @@index([status])
  @@index([expiresAt])
  @@map("booking_dispatches")
}

model Notification {
  id           String   @id @default(cuid())
  recipientId  String
  type         String
  title        String
  message      String
  bookingId    String?
  metadata     Json?
  isRead       Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user         User     @relation(fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model DevicePushToken {
  id         String    @id @default(cuid())
  userId     String
  pushToken  String    @unique
  deviceId   String?
  platform   String?
  appVersion String?
  isActive   Boolean   @default(true)
  lastSeenAt DateTime? @default(now())
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([pushToken])
  @@map("device_push_tokens")
}

model BookingSparePart {
  id        String   @id @default(cuid())
  bookingId String
  name      String
  category  String?
  unitPrice Float
  quantity  Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  
  @@index([bookingId])
  @@map("booking_spare_parts")
}

model TechnicianWallet {
  id               String            @id @default(cuid())
  technicianId     String            @unique
  technician       TechnicianProfile @relation(fields: [technicianId], references: [id])
  availableBalance Float             @default(0.0)
  currency         String            @default("INR")
  updatedAt        DateTime          @updatedAt
  
  transactions     WalletTransaction[]

  @@map("technician_wallets")
}

enum WalletTransactionType {
  RECHARGE
  COMMISSION_CAPTURE
  JOB_EARNING
  WITHDRAWAL
  ADJUSTMENT
  CASH_COLLECTION_SETTLEMENT
}

model WalletTransaction {
  id               String                @id @default(cuid())
  walletId         String
  wallet           TechnicianWallet      @relation(fields: [walletId], references: [id])
  type             WalletTransactionType
  amount           Float
  balanceBefore    Float
  balanceAfter     Float
  referenceId      String?               // E.g., Booking ID or Payment Gateway ID
  description      String?
  createdAt        DateTime              @default(now())

  @@index([walletId, createdAt])
  @@map("wallet_transactions")
}

model AdminWallet {
  id                  String                   @id @default(cuid())
  availableBalance    Float                    @default(0.0)
  totalCommission     Float                    @default(0.0)
  totalGstCollected   Float                    @default(0.0)
  currency            String                   @default("INR")
  updatedAt           DateTime                 @updatedAt
  
  transactions        AdminWalletTransaction[]

  @@map("admin_wallets")
}

enum AdminWalletTransactionType {
  PLATFORM_COMMISSION
  GST_COLLECTION
  WITHDRAWAL
  ADJUSTMENT
}

model AdminWalletTransaction {
  id               String                     @id @default(cuid())
  walletId         String
  wallet           AdminWallet                @relation(fields: [walletId], references: [id])
  type             AdminWalletTransactionType
  amount           Float
  balanceBefore    Float
  balanceAfter     Float
  referenceId      String?                    // E.g., Booking ID
  description      String?
  createdAt        DateTime                   @default(now())

  @@index([walletId, createdAt])
  @@map("admin_wallet_transactions")
}

model Review {
  id           String            @id @default(cuid())
  bookingId    String            @unique
  customerId   String
  technicianId String
  serviceId    String?
  rating       Int
  comment      String
  suggestion   String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  booking      Booking           @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer     User              @relation(fields: [customerId], references: [id], onDelete: Cascade)
  technician   TechnicianProfile @relation(fields: [technicianId], references: [id], onDelete: Cascade)
  service      Service?          @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([customerId])
  @@index([technicianId])
  @@index([serviceId])
  @@map("reviews")
}

