# Application
NODE_ENV=development
PORT=3000
APP_NAME="Mubryx API"
API_PREFIX=api/v1

# Database
DATABASE_URL=postgresql://<user>:<password>@<host>:<port>/<database>?schema=public

# Redis
REDIS_HOST=<host>
REDIS_PORT=6379
REDIS_PASSWORD=<password_or_empty>
REDIS_DB=0

# JWT — use strong random secrets (min 32 chars) in production
JWT_ACCESS_SECRET=<strong_random_secret>
JWT_REFRESH_SECRET=<strong_random_secret>
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Security
BCRYPT_ROUNDS=12

# CORS (comma-separated list of allowed origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:8081

# Rate limiting
RATE_LIMIT_TTL=60000
RATE_LIMIT_MAX=100

# Storage
STORAGE_PROVIDER=wasabi
WASABI_ENDPOINT=https://s3.<region>.wasabisys.com
WASABI_REGION=<region>
WASABI_ACCESS_KEY=<access_key>
WASABI_SECRET_KEY=<secret_key>
WASABI_BUCKET=<bucket_name>

# SMS
SMS_PROVIDER=mock

# App URLs
CUSTOMER_APP_URL=<url>
TECHNICIAN_APP_URL=<url>
ADMIN_APP_URL=<url>
